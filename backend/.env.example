# Backend Environment Variables
# Copy this file to .env and fill in the values

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Optional ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 4000)
PORT=4000

# Frontend origin allowed by CORS (default: http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# Resend API key for lead email notifications (skipped silently if not set)
RESEND_API_KEY=

# Email sender address shown in lead notifications
EMAIL_FROM=LarpTech Leads <leads@larptech.io>

# Inbox that receives lead notifications
LEAD_INBOX_EMAIL=team@larptech.io
