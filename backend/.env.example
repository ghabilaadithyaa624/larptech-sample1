# Backend Environment Variables
# Copy this file to .env and fill in the values.
#
# Values are validated at startup. In production, invalid or missing required
# configuration stops the process with a list of every problem found — it never
# silently falls back to a default that would break form submissions.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
#
# TLS: certificate verification is ALWAYS enabled against a remote host. Any
# weaker sslmode in the URL (prefer / require / verify-ca) is upgraded to
# verify-full. Use verify-full explicitly — Neon recommends it and it is the only
# mode whose meaning is stable across the pg v8 -> v9 upgrade.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# In production this MUST be the real frontend origin. Previously an unset value
# silently became http://localhost:3000, which makes CORS block every browser
# form submission with no server-side error at all.
# Comma-separate several origins to allow Vercel preview deployments, e.g.
#   FRONTEND_ORIGIN=https://larptech.io,https://larptech-git-feature.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# ── Optional: environment ─────────────────────────────────────────────────────
# production | development | test. Defaults to development.
# NODE_ENV=production

# Port the Express server listens on (default: 4000, must be 1-65535)
PORT=4000

# Log verbosity: debug | info | warn | error (default: info).
# Use debug to include upstream provider error bodies in logs.
# LOG_LEVEL=info

# ── Optional: proxy and client IP ─────────────────────────────────────────────
# How many reverse-proxy hops to trust when resolving the client IP for rate
# limiting. Render terminates TLS at its edge and forwards once, so 1 is correct
# there. Defaults to 1 in production and 0 (off) elsewhere.
#
# Set this to the EXACT hop count. Too high lets a client forge X-Forwarded-For
# and evade rate limits; 0 in production collapses every client into one bucket.
# TRUST_PROXY_HOPS=1

# ── Optional: rate limiting ───────────────────────────────────────────────────
# Limits are per client IP (IPv6 is grouped by /64) and stored in process memory.
# See backend/src/lib/rateLimit.ts for the implications of an in-memory store:
# counters reset on redeploy and are per-instance if the service is scaled out.
#
# Defaults: leads 10/15min, waitlist 10/15min, health 120/min, everything else 100/15min.
# RATE_LIMIT_LEADS_MAX=10
# RATE_LIMIT_LEADS_WINDOW_MS=900000
# RATE_LIMIT_WAITLIST_MAX=10
# RATE_LIMIT_WAITLIST_WINDOW_MS=900000
# RATE_LIMIT_HEALTH_MAX=120
# RATE_LIMIT_HEALTH_WINDOW_MS=60000

# Set to 1 to disable rate limiting. Rejected in production; local dev only.
# RATE_LIMIT_DISABLED=0

# ── Optional: request handling ────────────────────────────────────────────────
# Maximum accepted JSON body. The largest valid payload is ~2.5 KB.
# JSON_BODY_LIMIT=16kb

# HTTP server timeouts (ms). Note requestTimeout bounds receiving the request,
# not how long a handler takes to respond.
# REQUEST_TIMEOUT_MS=30000
# HEADERS_TIMEOUT_MS=20000
# KEEP_ALIVE_TIMEOUT_MS=5000

# ── Optional: database tuning ─────────────────────────────────────────────────
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Path to a PEM root CA bundle. Only needed for a private CA — Neon serves
# publicly-signed certificates, which Node's bundled roots already trust.
# DATABASE_SSL_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# ── Optional: email notifications ─────────────────────────────────────────────
# Resend API key for lead email notifications. If unset, leads are still stored
# but no notification is sent (a warning is logged in production).
RESEND_API_KEY=

# Email sender address shown in lead notifications.
# The domain must be verified in Resend or every send is rejected.
EMAIL_FROM=LarpTech Leads <leads@larptech.io>

# Inbox that receives lead notifications.
LEAD_INBOX_EMAIL=team@larptech.io

# -----------------------------------------------------------------------------
# Lead de-duplication
# -----------------------------------------------------------------------------
# A repeat submission from the same address about the same service inside this window is
# treated as the same enquiry: the existing row is returned with `duplicate: true` instead
# of inserting a second row. Set to 0 to store every submission.
# Default: 10
# LEAD_DEDUPE_WINDOW_MINUTES=10

# -----------------------------------------------------------------------------
# Graceful shutdown
# -----------------------------------------------------------------------------
# How long the process will wait for in-flight requests to finish after SIGTERM before
# exiting anyway. Keep this below the platform's SIGKILL grace period (Render's is 30s).
# Default: 20000
# SHUTDOWN_GRACE_MS=20000

# -----------------------------------------------------------------------------
# Database-backed tests
# -----------------------------------------------------------------------------
# `npm run test:integration` runs against a real PostgreSQL and is skipped when this is
# unset. Point it at a disposable local database — never a shared or production one.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/larptech_test

# -----------------------------------------------------------------------------
# Team notification delivery (Resend)
# -----------------------------------------------------------------------------
# Notifications are NOT sent inside the request. The lead and a durable "send this" row are
# written in one transaction, and a background worker delivers them with bounded timeouts and
# retries, so a provider outage delays an email instead of losing it.
#
# Bound on the whole Resend request, including connection setup. Default: 5000
# RESEND_TIMEOUT_MS=5000
#
# How often the worker looks for due notifications. Default: 3000
# OUTBOX_POLL_MS=3000
#
# How many notifications the worker claims per tick. Default: 5
# OUTBOX_BATCH_SIZE=5
#
# How long a claimed notification stays reserved before another tick may reclaim it, in case
# the process dies mid-send. Default: 60000
# OUTBOX_LEASE_MS=60000
#
# Set to 0 to disable the worker entirely. Leads are still stored, but the team is NOT
# emailed — only useful for local work.
# OUTBOX_ENABLED=1
