# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# ── Required ──────────────────────────────────────────────────────────────────
# URL of the Express backend API server (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Optional ──────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (skipped if not set)
NEXT_PUBLIC_GA_ID=

# Canonical site URL used in metadata / OpenGraph / sitemap
NEXT_PUBLIC_SITE_URL=https://larptech.io
